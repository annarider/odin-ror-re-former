<h1>New User</h1>

<%= form_with model: @user do |form| %>
  <div>
    <%= form.label :username %>
    <%= form.text_field :username %>
  </div>

  <div>
    <%= form_label :email %>
    <%= form.email_field :email %>
  </div>

  <div>
    <%= form_label :password %>
    <%= form.password_field :password %>
  </div>

  <div><%= form.submit "Create User" %></div>

<% end %>
